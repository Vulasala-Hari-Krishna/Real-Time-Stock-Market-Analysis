# Alpha Vantage API key (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# AWS credentials (free tier)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# S3 bucket for data lake
S3_BUCKET_NAME=stock-market-datalake-bucket

# Kafka broker address
KAFKA_BROKER=localhost:9092

# Pipeline control
RUN_PIPELINE=true
MAX_ITERATIONS=10
POLL_INTERVAL_SECONDS=60

# Environment (dev, staging, prod)
ENVIRONMENT=dev

# Opt-in raw consumer (separate from the default silver Spark consumer)
RAW_LANDING_ENABLED=false
# Set before enabling; change only when Kafka source offsets are recreated/reset.
RAW_SOURCE_ID=
RAW_CONSUMER_GROUP=stock-raw-landing-v1
RAW_TOPIC=raw_stock_ticks
RAW_SPOOL_PATH=.state/raw-landing.sqlite3
RAW_FLUSH_INTERVAL_SECONDS=60
RAW_MAX_RECORDS=500
RAW_MAX_BATCH_BYTES=5242880
# Optional token when using temporary AWS credentials
AWS_SESSION_TOKEN=

# R8: local Airflow DAGs that trigger deployed Databricks jobs, then export/
# load their gold output into Snowflake. Also required by the Streamlit
# dashboard's Snowflake-backed history page (R5).
#
# Databricks (used both to auto-provision Airflow's `databricks_default`
# connection - see docker/docker-compose.yaml - and by the GitHub Actions
# deploy workflows as repo secrets of the same name)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA_PREFIX=stocks
DATABRICKS_BUNDLE_TARGET=dev

# Snowflake identifiers (not secrets - read via src/config/settings.py)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_LOADER_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_STAGING_SCHEMA=
SNOWFLAKE_SERVING_SCHEMA=
SNOWFLAKE_STAGE_NAME=
# Snowflake secrets (read directly from the environment, never through
# Settings - see dashboards/snowflake_loader.py and
# src/load/snowflake_snapshot.py). SNOWFLAKE_PRIVATE_KEY must be the PEM key
# as one line with literal "\n" escapes, not real newlines.
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
