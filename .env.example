# Alpha Vantage API key (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# AWS credentials (free tier)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# S3 bucket for data lake
S3_BUCKET_NAME=stock-market-datalake-bucket

# Kafka broker address
KAFKA_BROKER=localhost:9092

# Pipeline control
RUN_PIPELINE=true
MAX_ITERATIONS=10
POLL_INTERVAL_SECONDS=60

# Environment (dev, staging, prod)
ENVIRONMENT=dev

# Opt-in raw consumer (separate from the default silver Spark consumer)
RAW_LANDING_ENABLED=false
# Set before enabling; change only when Kafka source offsets are recreated/reset.
RAW_SOURCE_ID=
RAW_CONSUMER_GROUP=stock-raw-landing-v1
RAW_TOPIC=raw_stock_ticks
RAW_SPOOL_PATH=.state/raw-landing.sqlite3
RAW_FLUSH_INTERVAL_SECONDS=60
RAW_MAX_RECORDS=500
RAW_MAX_BATCH_BYTES=5242880
# Optional token when using temporary AWS credentials
AWS_SESSION_TOKEN=
